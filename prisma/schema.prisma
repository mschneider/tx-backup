generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Slot {
  id        Int      @id
  parentId  Int
  leaderId  Int?
  createdAt DateTime @default(now())
  blockTime DateTime
}

model Transaction {
  id           Int    @id @default(autoincrement())
  hash         String @unique
  slotId       Int
  CUConsumed   Int
  CURequested  Int
  TipPaid      Int
  PriorityPaid Int

  @@index([slotId])
}

model AccountKey {
  id        Int           @id @default(autoincrement())
  txId      Int
  addressId Int
  flags     Int

  @@index([txId])
  @@index([addressId])
}

model AccountAddress {
  id      Int    @id @default(autoincrement())
  address String @unique
}

model Lst {
  id        Int    @id @default(autoincrement())
  name      String
  mint      String
  votePk    String
  signer    String
  price     Float
  createdAt DateTime @default(now())
}